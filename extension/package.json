{
  "name": "docmind-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env BROWSER=chrome vite build --watch",
    "dev:chrome": "cross-env BROWSER=chrome vite build --watch",
    "dev:edge": "cross-env BROWSER=edge vite build --watch",
    "dev:firefox": "cross-env BROWSER=firefox vite build --watch",
    "build": "npm run build:chrome && npm run build:edge && npm run build:firefox",
    "build:chrome": "cross-env BROWSER=chrome vite build",
    "build:edge": "cross-env BROWSER=edge vite build",
    "build:firefox": "cross-env BROWSER=firefox vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/webextension-polyfill": "^0.12.4",
    "@vitejs/plugin-react": "^4.2.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-static-copy": "^1.0.0"
  }
}
